#!/bin/sh
# stdin: <localref> <localsha> <remoteref> <remotesha>
dir=$(dirname "$0")
zero=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha
do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    old=$(git merge-base "$local_sha" HEAD 2>/dev/null || true)
    [ -n "$old" ] || continue
  else
    old=$remote_sha
  fi
  "$dir/check-docs" "$old" "$local_sha" "Doc changes in this push ($local_ref -> $remote_ref)"
done
exit 0
